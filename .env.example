# Copy to .env and fill in. Never commit .env.

# Nansen API key (free plan works for development: https://www.nansen.ai/api)
NANSEN_API_KEY=
# Hard cap on Nansen credits a single process may spend (protects the free plan)
NANSEN_MAX_CREDITS_PER_RUN=40

# Base Sepolia RPC (public endpoint caps eth_getLogs at 200 blocks per call)
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org

# Local database (libSQL / SQLite file, or a Turso URL in production)
DATABASE_URL=file:data/agentscore.db
DATABASE_AUTH_TOKEN=

# Deployed AgentScore GenLayer contract (leave empty until deployed; scores then show "not_scored")
AGENTSCORE_CONTRACT_ADDRESS=0x07bf2207852FE8F47DDeE26C4f4F0B206D259e74
# localnet | studionet | testnetBradbury
GENLAYER_NETWORK=studionet

# REST API
API_PORT=8787
# Used by the MCP server and website to reach the API
AGENTSCORE_API_URL=http://localhost:8787
